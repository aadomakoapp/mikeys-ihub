{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mikeys-ihub",
  "compatibility_date": "2026-07-01",
  "assets": {
    "directory": "./dist",
    // Client-side routing: unknown paths serve index.html instead of a 404.
    "not_found_handling": "single-page-application"
  },
  "routes": [
    { "pattern": "mikeysihub.com", "custom_domain": true },
    { "pattern": "www.mikeysihub.com", "custom_domain": true }
  ]
}
